{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "DOM"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "strict": false,
    "strictBindCallApply": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["public", "node_modules", ".tmp-hydro-test*"]
}
