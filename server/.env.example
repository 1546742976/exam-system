# 复制为 server/.env，并替换全部 CHANGE_ME 值。
# 生成随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
CKYF_ADMIN_PASSWORD=CHANGE_ME_admin_password
CKYF_SESSION_SECRET=CHANGE_ME_session_secret
CKYF_SIGN_KEY=CHANGE_ME_shared_client_sign_key
# 可选：NUC 同时有校园网时，网关仍监听所有网卡，但服务端只访问本机 OJ。
CKYF_HOST=0.0.0.0
CKYF_PORT=8888
CKYF_UPSTREAM=http://127.0.0.1:8889
# 单场比赛填浏览器地址中的实际路径，例如 /contest/123456 或 /d/system/contest/123456
CKYF_CONTEST_URL=/contest/
# 只有网关确实放在 Caddy/Nginx 后面才开启，并填写代理地址。
CKYF_TRUST_PROXY_HEADERS=false
CKYF_TRUSTED_PROXIES=127.0.0.1,::1
